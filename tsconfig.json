{
  "compilerOptions": {
    "target": "ES2018",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["DOM", "ES2018", "ES2019.Array", "ES2020.String"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "importHelpers": false
  },
  "include": ["src/**/*.ts", "harness/**/*.ts"]
}
